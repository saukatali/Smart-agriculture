APP_NAME=AgriSmart API
APP_ENV=production
PORT=8000
HOST=0.0.0.0

# -------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------
# Option A (Recommended for Cloud: TiDB Cloud, Render, Railway, PlanetScale):
# Use a single connection URL (TLS is automatically verified via built-in certifi):
# DATABASE_URL=mysql+pymysql://<user>:<password>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/agrisokat?charset=utf8mb4

# Option B (Standard individual parameters for Local or Cloud):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=agrisokat

# Optional TLS overrides (automatically handled by default for remote hosts):
# DB_SSL_MODE=true
# DB_SSL_CA=/etc/secrets/isrgrootx1.pem

# -------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
